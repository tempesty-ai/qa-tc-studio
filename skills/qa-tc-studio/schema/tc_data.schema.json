{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tempesty-ai/qa-tc-studio/schema/tc_data.schema.json",
  "title": "qa-tc-studio TC data",
  "description": "테스트케이스 정본(single source of truth). render_report.py / validate_tc.py 가 이 파일을 읽는다.",
  "type": "object",
  "required": ["title", "menus"],
  "properties": {
    "title": { "type": "string", "description": "리포트 제목" },
    "id_prefix": { "type": "string", "default": "TC", "description": "TC ID 접두어. ID = {id_prefix}-{menu.code}-{group.code?}-{screen.code}-{nnn}" },
    "summary_label": { "type": "string", "default": "종합", "description": "종합 대메뉴 라벨" },
    "auto_nav": { "type": "boolean", "default": true, "description": "각 절차 맨 앞에 '…화면으로 이동' 단계를 자동 추가(권한 섹션 제외)" },
    "menus": {
      "type": "array", "minItems": 1,
      "description": "대메뉴(Depth1) 목록",
      "items": {
        "type": "object",
        "required": ["name", "code", "groups"],
        "properties": {
          "name": { "type": "string" },
          "code": { "type": "string", "description": "대메뉴 코드 (예: CFG, MON)" },
          "groups": {
            "type": "array",
            "description": "카테고리(Depth2). flat 메뉴는 code를 빈 문자열로.",
            "items": {
              "type": "object",
              "required": ["name", "screens"],
              "properties": {
                "name": { "type": "string" },
                "code": { "type": "string", "default": "" },
                "screens": {
                  "type": "array",
                  "description": "화면(Depth3)",
                  "items": {
                    "type": "object",
                    "required": ["name", "code", "cases"],
                    "properties": {
                      "name": { "type": "string" },
                      "code": { "type": "string" },
                      "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "Gap 분석 [영역, 이유, 처리] 3튜플. 생략 시 기본값 사용.",
      "items": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
    },
    "charters": {
      "type": "array",
      "description": "탐색 테스트 차터 [차터, 조건, 살펴볼 점] 3튜플. 생략 시 기본값 사용.",
      "items": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "description": "테스트케이스 1건. risk/confidence/techniques/automation 은 생략 시 규칙으로 자동 태깅.",
      "required": ["section", "func", "precondition", "process", "expected"],
      "properties": {
        "section":      { "type": "string", "description": "화면 내 섹션 (목록/등록/수정/삭제/조회/권한 등)" },
        "func":         { "type": "string", "description": "기능명 (한 줄 요약)" },
        "precondition": { "type": "string", "description": "사전조건" },
        "process":      { "type": "string", "description": "번호 절차. '1. ~를 클릭한다.\\n2. ~를 입력한다.' (개행 구분)" },
        "expected":     { "type": "string", "description": "기대결과 (가능하면 제품 실제 메시지)" },
        "note":         { "type": "string", "description": "비고/근거 (예: 'Partial', '자동화 N', 소스 파일)" },
        "risk":         { "type": "string", "enum": ["High", "Medium", "Low"] },
        "confidence":   { "type": "string", "enum": ["High", "Med", "Low"] },
        "automation":   { "type": "string", "enum": ["가능", "부분", "불가"] },
        "techniques":   { "type": "array", "items": { "type": "string" }, "description": "설계기법: 경계값분석/동등분할/결정테이블/상태전이/조합/네거티브/명세기반" }
      }
    }
  }
}
